# Copy to .env.local for local runs, or set as Windows user environment variables.
# Never commit real values. With either key missing the app runs in labelled demo mode.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional overrides (defaults from the Token Factory catalog, checked 2026-10-13)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Official domains that search and fetch may touch (comma separated)
# APP_ALLOWED_DOMAINS=mol.gov.tw,law.moj.gov.tw,dgpa.gov.tw,ey.gov.tw,dol.ny.gov,labor.ny.gov,dol.gov

# Public demo caps
# APP_PER_IP_PER_HOUR=6
# APP_PER_IP_PER_DAY=20
# APP_GLOBAL_RUNS_PER_DAY=60
# APP_GLOBAL_USD_PER_DAY=1.5
# APP_GLOBAL_TAVILY_CREDITS_PER_DAY=40
# Agent time limit per check (ms); after it, code fills gaps from the retrieved text
# APP_AGENT_DEADLINE_MS=40000
# APP_PER_RUN_USD=0.05
# APP_MAX_AGENT_STEPS=12
# APP_MAX_TAVILY_CALLS=12
# APP_MAX_TOOL_CALLS_PER_STEP=12
# APP_MAX_COMPLETION_TOKENS=4000
# APP_MAX_INPUT_CHARS=4000
# APP_FORCE_MOCK=1

# Scripted demo model with real Tavily retrieval (needs only TAVILY_API_KEY)
# APP_LIVE_SEARCH=1
# Disk cache for Tavily results; npm run eval and probe:sources default to .cache/tavily (gitignored).
# Without it, pages and searches are cached per URL per UTC day in memory (and /tmp on Vercel).
# TAVILY_CACHE_DIR=.cache/tavily
